# Export these settings into your shell; commands do not automatically read .env.
# Paths are relative to the current working directory.

# StubHub inputs, outputs and per-worker pacing
INPUT_CSV=data/worldcities.csv
EVENTS_CSV=output/events.csv
WGET_OUTPUT_DIR=output/wget_output
VENUE_OUTPUT_DIR=output/venues
PROGRESS_LOG_FILE=log/progress_log_event.log
CONCURRENT_CITIES=5
CONCURRENT_VENUES=10
WAIT_SECONDS=1.0
MAX_RETRIES=3
RETRY_DELAY=2.0
REQUEST_TIMEOUT=30
MAX_PAGES_PER_CITY=100
DUPLICATE_STOP_RATIO=0.75
EXPLORE_SORT_TYPE=Distance
EXPLORE_PAGE_SIZE=100

# Ticketmaster: serial country/date/category queries, default 30 dates
TICKETMASTER_COUNTRY_CODES=US
TICKETMASTER_CATEGORIES=concerts,sports
TICKETMASTER_START_DATE=
TICKETMASTER_DAYS=30
TICKETMASTER_REQUEST_INTERVAL=2.0
TICKETMASTER_MAX_RETRIES=5
TICKETMASTER_BLOCK_RETRY_DELAY=30.0
TICKETMASTER_MAX_PAGES_PER_QUERY=0
TICKETMASTER_SAVE_RAW_RESPONSES=true
TICKETMASTER_RESUME_RAW_RESPONSES=false
TICKETMASTER_CANCELLED_EVENTS_CSV=output/ticketmaster_cancelled_events.csv
TICKETMASTER_WGET_OUTPUT_DIR=output/ticketmaster_cancelled_events

# Matching; blank STUBHUB_EVENTS_CSV falls back to EVENTS_CSV
STUBHUB_EVENTS_CSV=
CANCELLED_EVENT_INTERSECTION_CSV=output/stubhub_ticketmaster_cancelled_intersection.csv

# Shared logging / optional browser user-agent override
LOG_LEVEL=INFO
SCRAPER_LOG_FILE=log/scraper.log
VENUE_FETCHER_LOG_FILE=log/venue_fetcher.log
TICKETMASTER_SCRAPER_LOG_FILE=log/ticketmaster_cancelled_events.log
# USER_AGENT='Your user-agent string'
